# Loja (HTML, CSS e JavaScript): o navegador sempre confere com o servidor se o arquivo mudou
# (resposta 304, sem baixar de novo quando nada mudou). Evita misturar arquivos novos com cópias
# antigas do cache depois de uma atualização do site (os scripts são módulos que importam uns aos outros).
# As páginas PHP do admin definem o próprio cabeçalho (no-store) e não entram nesta regra.
<IfModule mod_headers.c>
    <FilesMatch "\.(html|css|js)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>

    # Cabeçalhos de segurança em todas as respostas da loja ("setifempty": não substitui os que
    # as páginas do admin já enviam, como X-Frame-Options: DENY).
    Header setifempty X-Content-Type-Options "nosniff"
    Header setifempty Referrer-Policy "same-origin"
    Header setifempty X-Frame-Options "SAMEORIGIN"
    Header setifempty Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
</IfModule>
